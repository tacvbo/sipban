#!/bin/bash
# Fake ipset for the tests: the members of the set are lines of
# $FAKE_STATE/members, and every call is appended to $FAKE_STATE/calls.log.
# It only implements the commands that sipban.pl uses. IPSET_FAIL is a list
# of commands that fail, e.g. IPSET_FAIL="add save".
D="${FAKE_STATE:?FAKE_STATE is not set}"
echo "ipset $*" >> "$D/calls.log"
[ "$1" = "-q" ] && shift
case " $IPSET_FAIL " in
  *" $1 "*) echo "ipset v6.11: simulated failure of $1" >&2; exit 1 ;;
esac
case "$1" in
  list)
    if [ "$2" = "-t" ]; then
      if [ -e "$D/set" ]; then echo "Name: $3"; else echo "The set does not exist" >&2; exit 1; fi
    else
      [ -e "$D/set" ] || exit 1
      echo "Name: $2"; echo "Type: hash:net"; echo "Members:"
      [ -e "$D/members" ] && sed 's/$/ timeout 600000/' "$D/members"
    fi ;;
  create)  touch "$D/set" ;;
  destroy) rm -f "$D/set" "$D/members" ;;
  save)
    echo "create $2 hash:net family inet hashsize 4096 maxelem 65536 timeout 604800"
    [ -e "$D/members" ] && sed "s/^/add $2 /; s/\$/ timeout 600000/" "$D/members" ;;
  restore)
    # as the real ipset: only a "create" line creates the set
    line=0
    while read -r command name ip rest; do
      line=$((line + 1))
      case "$command" in
        create) touch "$D/set" "$D/members" ;;
        add)
          if [ ! -e "$D/set" ]; then
            echo "ipset v6.11: Error in line $line: The set with the given name does not exist" >&2
            exit 1
          fi
          grep -qxF "$ip" "$D/members" || echo "$ip" >> "$D/members" ;;
      esac
    done ;;
  add) touch "$D/members"; grep -qxF "$3" "$D/members" || echo "$3" >> "$D/members" ;;
  del) touch "$D/members"; grep -vxF "$3" "$D/members" > "$D/members.tmp"; mv "$D/members.tmp" "$D/members" ;;
esac
exit 0
