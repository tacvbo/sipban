#!/bin/bash
#
# chkconfig: 35 99 99
# description: SIPban, blocks SIP attackers using the Asterisk AMI security events
# processname: sipban.pl

# source function library
. /etc/rc.d/init.d/functions

DAEMON="/usr/local/bin/sipban.pl >> /var/log/sipban_daemon.log 2>&1"
OPTIONS=-d
RETVAL=0

case "$1" in
  start)
	echo -n "Starting SIPban: "
	daemon $DAEMON $OPTIONS
	RETVAL=$?
	echo
	# with -d, sipban.pl detaches before it reads its configuration, so an
	# error at startup only shows up a moment later
	if [ $RETVAL -eq 0 ]; then
		sleep 2
		if ! status sipban.pl > /dev/null; then
			echo "SIPban stopped at startup, see /var/log/sipban.log"
			RETVAL=1
		fi
	fi
	[ $RETVAL -eq 0 ] && touch /var/lock/subsys/sipban.pl
	;;
  stop)
	echo -n "Stopping SIPban: "
	killproc sipban.pl
	RETVAL=$?

	echo
	[ $RETVAL -eq 0 ] && rm -f /var/lock/subsys/sipban.pl
	;;
  restart)
	$0 stop
	$0 start
	RETVAL=$?
	;;
  reload)
	# sipban.pl stops on HUP, so a reload is a restart (the blocked IPs are
	# saved to the dump file and restored)
	$0 restart
	RETVAL=$?
	;;
  status)
	status sipban.pl
	RETVAL=$?
	;;
  *)
	echo "Usage: sipban {start|stop|status|restart|reload}"
	exit 1
esac

exit $RETVAL

